# ── Required ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (REQUIRED — app will not start without this)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# ── Optional ──────────────────────────────────────────────────────────────────
# JWT signing secret (change this in production)
JWT_SECRET=change-this-to-a-long-random-secret

# Deployed frontend URL (added to CORS allowed origins)
FRONTEND_URL=https://your-frontend.vercel.app

# Tesseract binary path override (auto-detected on Windows; set this on Linux/Mac if needed)
# TESSERACT_CMD=/usr/bin/tesseract

# Set to "true" only during local development — never in production
FLASK_DEBUG=false
